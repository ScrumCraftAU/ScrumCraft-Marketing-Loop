# Copy to .env.local. With the Supabase values empty the app runs in "not configured"
# mode (pages render, no data). All secrets are server-only — nothing is NEXT_PUBLIC.

# Supabase — Project Settings → API. Use the SECRET key (sb_secret_...), server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Anthropic — powers the daily PDCA analysis. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5
LOOP_MODEL=

# Shared secret Zapier sends as the `x-ingest-secret` header to /api/ingest/<source>
INGEST_SECRET=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/loop/cron
CRON_SECRET=

# Confluence (strategy docs for the loop). Create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens — read access is enough.
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Optional; defaults to https://scrumcraft.atlassian.net
CONFLUENCE_BASE_URL=
